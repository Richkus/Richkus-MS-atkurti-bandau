---
interface Props {
  currentPage: number
  totalPages: number
  hrefFor: (page: number) => string
}

const { currentPage, totalPages, hrefFor } = Astro.props
const pages = Array.from({ length: totalPages }, (_, i) => i + 1)
---

<nav class="pagination" aria-label="Puslapiavimas">
  <a
    class="pagination__link pagination__link--nav"
    href={currentPage > 1 ? hrefFor(currentPage - 1) : undefined}
    aria-disabled={currentPage <= 1}
  >
    Atgal
  </a>
  <ul class="pagination__list">
    {
      pages.map((page) => (
        <li>
          <a
            href={hrefFor(page)}
            class={`pagination__link ${page === currentPage ? 'pagination__link--active' : ''}`}
            aria-current={page === currentPage ? 'page' : undefined}
          >
            {page}
          </a>
        </li>
      ))
    }
  </ul>
  <a
    class="pagination__link pagination__link--nav"
    href={currentPage < totalPages ? hrefFor(currentPage + 1) : undefined}
    aria-disabled={currentPage >= totalPages}
  >
    Toliau
  </a>
</nav>

<style>
  .pagination {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .pagination__list {
    display: flex;
    gap: var(--space-1);
  }

  .pagination__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }
  .pagination__link:hover {
    background: var(--color-surface);
    text-decoration: none;
  }

  .pagination__link--active {
    background: var(--color-primary);
    color: var(--color-text-inverse);
  }
  .pagination__link--active:hover {
    background: var(--color-primary);
  }

  .pagination__link--nav[aria-disabled='true'] {
    pointer-events: none;
    color: var(--color-text-muted);
    opacity: 0.5;
  }
</style>
