---
interface Tab {
  id: string
  label: string
}

interface Props {
  tabs: Tab[]
  active?: string
}

const { tabs, active = tabs[0]?.id } = Astro.props

// Astro's <slot name={...}> compiler directive requires a static string, so
// dynamic per-tab slots are rendered programmatically here instead.
const panels = await Promise.all(
  tabs.map(async (tab) => ({
    id: tab.id,
    html: await Astro.slots.render(tab.id),
  }))
)
---

<div class="tabs" data-tabs>
  <div class="tabs__list" role="tablist">
    {
      tabs.map((tab) => (
        <button
          type="button"
          role="tab"
          class="tabs__tab"
          data-tab-trigger={tab.id}
          aria-selected={tab.id === active ? 'true' : 'false'}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <div class="tabs__panels">
    {
      panels.map((panel) => (
        <div
          class="tabs__panel"
          data-tab-panel={panel.id}
          hidden={panel.id !== active}
          set:html={panel.html}
        />
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll('[data-tabs]').forEach((root) => {
    if (root.getAttribute('data-tabs-init')) return
    root.setAttribute('data-tabs-init', 'true')

    const triggers = Array.from(root.querySelectorAll('[data-tab-trigger]'))
    const panels = Array.from(root.querySelectorAll('[data-tab-panel]'))

    triggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-tab-trigger')
        triggers.forEach((b) => b.setAttribute('aria-selected', b === btn ? 'true' : 'false'))
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute('data-tab-panel') !== id
        })
      })
    })
  })
</script>

<style>
  .tabs__list {
    display: flex;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .tabs__tab {
    padding: var(--space-2) var(--space-4);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    font-family: var(--font-family-base);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .tabs__tab:hover {
    color: var(--color-primary-dark);
  }

  .tabs__tab[aria-selected='true'] {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .tabs__panels {
    padding-top: var(--space-4);
  }
</style>
