---
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/low-fidelity.css'
import Header from '../components/layout/Header.astro'
import Sidebar from '../components/layout/Sidebar.astro'
import Footer from '../components/layout/Footer.astro'
import PrototypeControls from '../components/layout/PrototypeControls.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang="lt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Web Prototyping Framework</title>
    <script is:inline>
      // Blokuojantis inline script — nustato data-fidelity/data-sidebar prieš
      // pirmą atvaizdavimą, kad nebūtų "flash" efekto pakeičiant temą.
      ;(function () {
        try {
          var fidelity = localStorage.getItem('ms-prototype:fidelity') === 'low' ? 'low' : 'normal'
          var sidebar = localStorage.getItem('ms-prototype:sidebar') === 'collapsed' ? 'collapsed' : 'expanded'
          document.documentElement.setAttribute('data-fidelity', fidelity)
          document.documentElement.setAttribute('data-sidebar', sidebar)
        } catch (e) {
          document.documentElement.setAttribute('data-fidelity', 'normal')
          document.documentElement.setAttribute('data-sidebar', 'expanded')
        }
      })()
    </script>
  </head>
  <body>
    <div class="app-shell">
      <PrototypeControls />
      <Sidebar />
      <Header />
      <main class="app-shell__main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .app-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: var(--sidebar-width) 1fr;
    grid-template-rows: var(--prototype-controls-height) var(--header-height) 1fr auto;
    grid-template-areas:
      'controls controls'
      'sidebar header'
      'sidebar main'
      'sidebar footer';
  }

  .app-shell__main {
    grid-area: main;
    padding: var(--space-6) var(--space-5);
    max-width: var(--content-max-width);
    width: 100%;
  }

  @media (max-width: 1024px) {
    .app-shell {
      grid-template-columns: 1fr;
      grid-template-areas:
        'controls'
        'header'
        'main'
        'footer';
    }
  }
</style>
